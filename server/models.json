    "ollama": {
        "models": {
          "gemma4:e4b": {
            "capabilities": [],
            "enabled": true,
            "status": "ready",
            "parameters": {
              "temperature": {
                  "displayName": "Temperature",
                  "description": "控制生成文本的随机性。较低的值使输出更确定，较高的值使输出更随机。",
                  "value": 0.7,
                  "range": [0.0, 2.0],
                  "step": 0.1
              },
              "maximumLength": {
                  "displayName": "Maximum Length",
                  "description": "生成的最大token数量。",
                  "value": 512,
                  "range": [1, 4096]
              },
              "topP": {
                  "displayName": "Top P",
                  "description": "核采样概率。仅从累积概率超过此阈值的token中采样。",
                  "value": 0.9,
                  "range": [0.0, 1.0],
                  "step": 0.05
              },
              "topK": {
                  "displayName": "Top K",
                  "description": "从概率最高的K个token中采样。设置为0时禁用。",
                  "value": 40,
                  "range": [0, 100]
              },
              "repetitionPenalty": {
                  "displayName": "Repetition Penalty",
                  "description": "惩罚重复token。值越高，惩罚越重。",
                  "value": 1.1,
                  "range": [1.0, 2.0],
                  "step": 0.1
              },
              "frequencyPenalty": {
                  "displayName": "Frequency Penalty",
                  "description": "减少重复已频繁出现的token。",
                  "value": 0.0,
                  "range": [-2.0, 2.0],
                  "step": 0.1
              },
              "presencePenalty": {
                  "displayName": "Presence Penalty",
                  "description": "惩罚已出现的token，无论其频率如何。",
                  "value": 0.0,
                  "range": [-2.0, 2.0],
                  "step": 0.1
              },
              "stopSequences": {
                  "displayName": "Stop Sequences",
                  "description": "生成文本时遇到这些序列则停止。",
                  "value": [],
                  "range": []
              }
            }
          }
      },
      "requiresAPIKey": false,
      "remoteInference": true,
      "defaultParameters": null,
      "apiURL": "http://192.168.1.3:11434"
    },
